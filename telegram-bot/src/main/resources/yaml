databaseChangeLog:
  - include:
      file: db/changelog/changelog-1.0.yaml

databaseChangeLog:
  - changeSet:
      id: 1
      author: telegram-bot
      changes:
        - createTable:
            tableName: notification_task
            columns:
              - column:
                  name: id
                  type: bigint
                  autoIncrement: true
                  constraints:
                    primaryKey: true
                    nullable: false
              - column:
                  name: chat_id
                  type: bigint
                  constraints:
                    nullable: false
              - column:
                  name: message_text
                  type: varchar(1000)
                  constraints:
                    nullable: false
              - column:
                  name: notification_date_time
                  type: timestamp
                  constraints:
                    nullable: false
